{
  "name": "design-flow-harness-codex",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Kiro용 기존 Figma 시스템 추출·확장·수정·동기화·커버리지·검증 하네스",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "status": "node scripts/harness.mjs status",
    "check": "node scripts/harness.mjs check",
    "check:inputs": "node scripts/harness.mjs check --phase inputs",
    "check:extract-system": "node scripts/harness.mjs check --phase extract-system",
    "check:components": "node scripts/harness.mjs check --phase components",
    "check:screens": "node scripts/harness.mjs check --phase screens",
    "audit": "node scripts/harness.mjs audit && node scripts/coverage-gate.mjs",
    "doctor": "node scripts/harness.mjs doctor",
    "fingerprint": "node scripts/harness.mjs fingerprint",
    "save-snapshot": "node scripts/harness.mjs save-snapshot",
    "validate-tokens": "node scripts/validate-spec-tokens.mjs",
    "tokens:export": "node scripts/harness.mjs export-tokens",
    "test": "node --test tests/*.test.mjs",
    "assets:list": "node scripts/harness.mjs assets-list",
    "patterns:resolve": "node scripts/pattern-registry.mjs resolve",
    "patterns:search": "node scripts/pattern-registry.mjs search",
    "patterns:discover": "node scripts/pattern-registry.mjs discover",
    "patterns:refresh": "node scripts/refresh-pattern-sources.mjs",
    "patterns:refresh-snapshot": "node scripts/pattern-registry.mjs refresh",
    "visual-dna:derive": "node scripts/visual-dna.mjs derive",
    "merge:components-snapshot": "node scripts/merge-component-snapshots.mjs",
    "check:coverage": "node scripts/coverage-gate.mjs",
    "audit:structural": "node scripts/harness.mjs audit"
  }
}
